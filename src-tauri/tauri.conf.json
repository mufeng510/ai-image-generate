{
  "$schema": "https://tauri.app/schema/config.json",
  "identifier": "com.doubao.batchimage",
  "build": {
    "frontendDist": "../src-tauri/gen/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "豆包批量生图",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon-256.png",
      "icons/icon-128.png",
      "icons/icon-48.png",
      "icons/icon-32.png",
      "icons/icon-16.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNUM5OTgyQkZCRTY5NUMKUldSY2FiNi9ncGxjdXBYdWtWSWM0TnYvVk9tTXdnQ256YlJ3aFlYZlJDb1FaV28vcFF0ZVQwUlQK",
      "endpoints": [
        "https://github.com/mufeng510/ai-image-generate/releases/latest/download/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
